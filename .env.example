# Google Gemini API Key (Required for AI Ideation, Scripting, Background Gen,
# YouTube Metadata, AND parent voice cloning — cloning reuses this same key,
# no separate voice-service key needed)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Multi-Provider Fallback Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# Local Ollama URL (Optional for offline mode)
OLLAMA_URL=http://localhost:11434
