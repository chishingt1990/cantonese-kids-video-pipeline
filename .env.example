# Google Gemini API key for optional text generation and adult voice replication.
# Background and character tools transform existing artwork; they are not AI
# image-generation services. Provider calls send the supplied content off-device.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional provider credentials. Providers must be selected explicitly.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# Local Ollama URL (Optional for offline mode)
OLLAMA_URL=http://localhost:11434

# Optional separate location for private working data (absolute path).
# KIDS_STUDIO_DATA_DIR=C:\Users\YourName\KidsStudioData

# Optional explicit encoder paths instead of PATH discovery.
# KIDS_STUDIO_FFMPEG=C:\Tools\ffmpeg\bin\ffmpeg.exe
# KIDS_STUDIO_FFPROBE=C:\Tools\ffmpeg\bin\ffprobe.exe
# KIDS_STUDIO_CJK_FONT=C:\Windows\Fonts\msjh.ttc

# Optional local Cantonese word alignment (no model is downloaded automatically).
# Install requirements-alignment.txt and point to converted large-v3 weights.
# KIDS_STUDIO_WHISPER_MODEL=C:\Models\faster-whisper-large-v3
